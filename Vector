#include <iostream>
#include <vector>
using namespace std;

int main()
{
    vector<char>vec = {'a','b','c'};

    cout << "size = " << vec.size() <<endl;
    vec.push_back('d');
    vec.push_back('e');
    vec.push_back('f');
    cout << "after push back size = " << vec.size() <<endl;

    vec.pop_back();

    for(char val:vec)
    {
        cout<<val<<endl;
    }

    cout<<"Front:"<<vec.front()<<endl;
    cout<<"Back:"<<vec.back()<<endl;
    cout<<"At:"<<vec.at(3)<<endl;
    return 0;
}
